# CLI deploys upload only what the app needs to build. Allowlist, so nothing local
# (wallet keys, env files, notes) can ride along.
/*
!/app
!/components
!/content
!/lib
!/public
!/package.json
!/package-lock.json
!/next.config.ts
!/tsconfig.json
!/next-env.d.ts
!/eslint.config.mjs
!/README.md
# The build runs the database migrations first (npm run build), and Vercel reads the daily
# mail cron from vercel.json. Only the migration script itself, not the rest of scripts/.
!/db
!/scripts
/scripts/*
!/scripts/migrate.mts
!/vercel.json
